#!/bin/bash

source "$HOME/.espressif/tools/activate_idf_v6.0.2.sh"

# direnv only imports exported env vars from this script, not the shell
# functions/aliases it defines (idf.py, otatool.py, parttool.py). Put their
# real script directories on PATH instead so they resolve as plain commands.
PATH_add "$IDF_PATH/tools"
PATH_add "$IDF_PATH/components/app_update"
PATH_add "$IDF_PATH/components/partition_table"

# The ESP-IDF activation script puts the esp32ulp-elf toolchain's bin dir
# ahead of /usr/bin, and it ships an unprefixed `as` built only for the ULP
# coprocessor. That shadows the system assembler and breaks host builds
# (e.g. `make build sitl`), which invoke `cc`/`as` by bare name via PATH.
# Re-prioritize /usr/bin so host builds get the real assembler; cross
# builds still resolve their prefixed compilers (xtensa-esp32-elf-gcc, etc).
PATH_add /usr/bin

export PATH
