[Unit]
Description=Configure Pi mesh from hostname
Requires=NetworkManager.service sys-subsystem-net-devices-wlan0.device
After=NetworkManager.service systemd-networkd.service sys-subsystem-net-devices-wlan0.device

[Service]
Type=oneshot
User=root
ExecStart=/bin/bash /usr/local/sbin/setup_mesh.sh
RemainAfterExit=yes
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target