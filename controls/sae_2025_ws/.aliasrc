#!/usr/bin/env bash

# aliases for faster development

# BUILDING
alias cb='colcon build'
alias cbp='colcon build --packages-select'
alias cbpsi='colcon build --symlink-install --packages-select'

# rm -rf's the build and install of each specified package
cleanp() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: cleanp <package> [package ...]"
        return 1
    fi

    for pkg in "$@"; do
        rm -rf "build/$pkg" "install/$pkg"
    done
}

# TESTING
ctp() {
# 1. runs colcon tests on selected packages
# 2. merges xml test results into build/merged_results.xml
# 3. Views merged_result.xml with xunit-viewer
# runs unit tests from the selected packages
    local pkgs=("$@")
    colcon test --packages-select "${pkgs[@]}"
    local test_status=$?

    local paths=()
    for pkg in "${pkgs[@]}"; do
	    local pytest_xml="build/${pkg}/pytest.xml"
	    local gtest_glob="build/${pkg}/test_results/${pkg}/*.gtest.xml"

	    [[ -f "$pytest_xml" ]] && paths+=("$pytest_xml")
	    compgen -G "$gtest_glob" >/dev/null 2>&1 && paths+=("$gtest_glob")
	done

	if [[ ${#paths[@]} -eq 0 ]]; then
		echo "ctp: no test result files found for: ${pkgs[*]}" >&2
		return 1
	fi

	junitparser merge --glob "${paths[@]}" build/merged_results.xml
    xunit-viewer -r build/merged_results.xml --console -C false -o build/merged_results.html
    return "$test_status"
}

# Runs unit tests from ALL packages
ct() {
    mapfile -t pkgs < <(colcon list -n)
    ctp "${pkgs[@]}"
}

# Runs all sim tests from ALL packages. Only supports ament_python packages so far.
ctsim() {
    mapfile -t pkgs < <(colcon list | grep 'ament_python' | awk '{print $1}')
    colcon test --packages-select "${pkgs[@]}" --event-handlers console_direct+ --pytest-args -s -o python_files="sim_test_*.py"
}

# Runs all sim tests from the selected/specified packages
alias ctpsim='colcon test --pytest-args -s -o python_files="sim_test_*.py" --event-handlers console_direct+ --packages-select'



# Clang-format shortcut
cfmt() {
    local check=false

    case "${1:-}" in
        "")
            ;;
        --check)
            check=true
            ;;
        *)
            echo "Usage: cfmt [--check]"
            echo "  cfmt          Apply clang-format"
            echo "  cfmt --check  Check formatting without modifying files"
            return 1
            ;;
    esac

    local files
    files=$(git ls-files | grep -E '\.(cpp|h|hpp|cc)$')

    if [[ -z "$files" ]]; then
        echo "No matching C/C++ files found."
        return 0
    fi

    if $check; then
        echo "Checking clang-format..."
        echo "$files" | xargs clang-format --dry-run --Werror --verbose
    else
        echo "Applying clang-format..."
        echo "$files" | xargs clang-format -i --style=file
    fi
}
