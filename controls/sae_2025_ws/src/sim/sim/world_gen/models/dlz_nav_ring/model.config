<?xml version="1.0"?>
<model>
  <name>DLZ Nav Ring</name>
  <version>1.0</version>
  <sdf version="1.4">model.sdf</sdf>

  <author>
    <name>Brian</name>
  </author>

  <description>
    Pink DLZ pad with colored navigation ring. No hash marks.
    Four quadrant segments (red 0-89 deg, blue 90-179 deg,
    yellow 180-269 deg, green 270-359 deg) for payload navigation.
    Spawn at the same position as the dlz model.
  </description>
</model>
