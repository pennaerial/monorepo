<?xml version="1.0"?>
<model>
  <name>DLZ Alternating Border</name>
  <version>1.0</version>
  <sdf version="1.4">model.sdf</sdf>

  <author>
    <name>Brian</name>
  </author>

  <description>
    Pink DLZ pad with a square alternating-color border for payload navigation.
    Border is ~6 inches (0.1524m) inset from the edge of the 8ft x 8ft pad,
    forming a square at 1.0668m from the DLZ center.

    Each side is split into two equal segments. In CCW travel order each side
    is [Blue (B), Orange (A)]. Corner rule:
      - Going CCW: A-to-B color transition = corner, turn 90 deg left
      - Going CW:  B-to-A color transition = corner, turn 90 deg right

    Spawn at the same position as the dlz model.
  </description>
</model>
