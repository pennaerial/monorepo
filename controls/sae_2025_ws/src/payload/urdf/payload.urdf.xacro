<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="payload">
  <!-- Placeholder RViz model. Gazebo continues to use models/payload/model.sdf. -->
  <xacro:property name="body_length" value="0.50"/>
  <xacro:property name="body_width" value="0.28"/>
  <xacro:property name="body_height" value="0.15"/>
  <xacro:property name="tread_length" value="0.50"/>
  <xacro:property name="tread_width" value="0.08"/>
  <xacro:property name="tread_height" value="0.12"/>

  <material name="payload_body_color">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>

  <material name="payload_tread_color">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.135" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="payload_body_color"/>
    </visual>
  </link>

  <link name="left_tread">
    <visual>
      <geometry>
        <box size="${tread_length} ${tread_width} ${tread_height}"/>
      </geometry>
      <material name="payload_tread_color"/>
    </visual>
  </link>

  <joint name="left_tread_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_tread"/>
    <origin xyz="0 0.18 0.06" rpy="0 0 0"/>
  </joint>

  <link name="right_tread">
    <visual>
      <geometry>
        <box size="${tread_length} ${tread_width} ${tread_height}"/>
      </geometry>
      <material name="payload_tread_color"/>
    </visual>
  </link>

  <joint name="right_tread_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_tread"/>
    <origin xyz="0 -0.18 0.06" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.05 0.06 0.04"/>
      </geometry>
      <material name="payload_body_color"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.23 0 0.20" rpy="0 0 0"/>
  </joint>
</robot>
