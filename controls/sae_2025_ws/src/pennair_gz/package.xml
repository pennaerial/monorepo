<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pennair_gz</name>
  <version>0.0.0</version>
  <description>Custom Gazebo plugins</description>
  <maintainer email="yuzhiliu8@gmail.com">yuzhiliu8</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>sae_gz_cmake</buildtool_depend>

  <depend>custom_gz_msgs</depend>
  <depend>sim_interfaces</depend>

  <test_depend>ament_lint_auto</test_depend>
  <!-- ruff owns Python style; declare the relevant lints accordingly -->
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_uncrustify</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
