<?xml version="1.0"?>
<model>
  <name>DLZ Nav Line</name>
  <version>1.0</version>
  <sdf version="1.4">model.sdf</sdf>

  <author>
    <name>Brian</name>
  </author>

  <description>
    Colored navigation circle overlaid on the DLZ. Four quadrant segments
    (red 0-89 deg, blue 90-179 deg, yellow 180-269 deg, green 270-359 deg)
    allow the payload to determine its position around the landing zone.
    Spawn at the same position as the dlz model.
  </description>
</model>
