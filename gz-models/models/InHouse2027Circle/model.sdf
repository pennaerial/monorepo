<?xml version="1.0"?>
<!--
  In-house 2027 challenge ground marker: circle.
  mesh.stl is ~25 mm across x 5 mm thick; scaled to ~1 m across x 1 cm thick.
  Colours are defaults - in_house_2026_node.py overrides ambient/diffuse per instance.
-->
<sdf version="1.9">
  <model name="InHouse2027Circle">
    <static>true</static>
    <link name="link">
      <pose>0.0000 0.0000 0 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://InHouse2027Circle/mesh.stl</uri>
            <scale>40 40 2</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
      <collision name="collision">
        <pose>0.0000 0.0000 0.0051 0 0 0</pose>
        <geometry>
          <box>
            <size>1.016 1.016 0.0102</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
