<?xml version="1.0"?>
<!--
  PFM-1 butterfly mine, ~120 x 66 x 21 mm, lying flat face up.
  Meshes are in metres, footprint centred on the origin, underside at z = 0
  (built by gz-models/tools/prepare_pfm1_mesh.py). pfm1_low.stl is the decimated
  copy used when thousands of mines are drawn. No collision: mines are scenery.
  iarc_field_node.py merges one copy of this visual per mine into a single model.
-->
<sdf version="1.9">
  <model name="PFM1">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://PFM1/meshes/pfm1.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.149 0.384 0.275 1</ambient>
          <diffuse>0.149 0.384 0.275 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
